{
  "name": "otools-rscode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SideX workbench as an OTools standalone plugin: VS Code's TypeScript workbench on the OTools webview host.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "sync-upstream": "node scripts/sync-upstream.mjs",
    "check-upstream": "node scripts/sync-upstream.mjs --check",
    "build": "node scripts/build.mjs",
    "tree": "node scripts/build.mjs --tree",
    "dev": "node scripts/dev.mjs",
    "preview": "node scripts/serve-dist.mjs",
    "test": "node scripts/test.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "pack": "node scripts/pack-plugin.mjs && node scripts/verify-plugin.mjs",
    "verify": "node scripts/verify-plugin.mjs"
  },
  "dependencies": {
    "@microsoft/1ds-core-js": "^4.3.11",
    "@microsoft/1ds-post-js": "^4.3.11",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-shell": "^2",
    "@vscode/codicons": "^0.0.45",
    "@vscode/iconv-lite-umd": "^0.7.1",
    "@vscode/tree-sitter-wasm": "^0.3.0",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-ligatures": "^0.10.0",
    "@xterm/addon-progress": "^0.2.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "monaco-editor": "^0.52.2",
    "otools-plugin-sdk": "^0.3.0",
    "tas-client": "^0.3.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^22.10.0",
    "@types/trusted-types": "^2.0.7",
    "@webgpu/types": "^0.1.69",
    "jsdom": "^31.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vite-plugin-static-copy": "^2.2.0",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "^3.4.17",
      "minimatch": "^11.0.1"
    }
  }
}
